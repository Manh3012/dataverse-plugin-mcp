{
  "name": "dataverse-plugin-tools",
  "displayName": "Dataverse Plugin Tools",
  "description": "Register, profile, replay and step-debug Dataverse plug-ins from Claude Code: the DataversePluginMcp server (built from source on first start) and skills for registering, troubleshooting, Custom APIs, webhooks and debugging.",
  "version": "0.1.0",
  "author": { "name": "Manh3012", "url": "https://github.com/Manh3012" },
  "homepage": "https://github.com/Manh3012/dataverse-plugin-mcp",
  "repository": "https://github.com/Manh3012/dataverse-plugin-mcp",
  "license": "MIT",
  "types": "./types/index.d.ts",
  "keywords": ["dataverse", "dynamics-365", "power-platform", "plugin", "debugging", "mcp"],
  "mcpServers": {
    "dataverse": {
      "command": "cmd",
      "args": ["/d", "/c", "${CLAUDE_PLUGIN_ROOT}/scripts/start-server.cmd"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/build.ps1\" -Hook",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
